# GuardianBox Environment Configuration

# Server Port
PORT=5000

# Client Web Application URL
CLIENT_URL=http://localhost:5173

# Storage Provider: 'local' (default for dev/offline) or 's3' (AWS S3 / MinIO)
STORAGE_PROVIDER=local

# Maximum Upload File Size in Megabytes
MAX_FILE_SIZE_MB=100

# Ephemeral Storage Cleanup Cron Schedule (Standard 5-part cron syntax)
# Default dev: runs every 5 minutes (*/5 * * * *). Production: hourly (0 * * * *)
CLEANUP_CRON=*/5 * * * *

# -------------------------------------------------------------
# AWS S3 / MinIO Configuration (Required only when STORAGE_PROVIDER=s3)
# -------------------------------------------------------------
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=guardianbox-encrypted-vault
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# For MinIO or LocalStack (Optional):
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
